# This file is used for Git repositories to specify intentionally untracked files that Git should ignore. 
# If you are not using git, you can delete this file. For more information see: https://git-scm.com/docs/gitignore
# For useful gitignore templates see: https://github.com/github/gitignore

# Salesforce cache
.sf/
.sfdx/*
!.sfdx/typings
!.sfdx/tsconfig.sfdx.json
.localdevserver/
deploy-options.json

# LWC VSCode autocomplete
**/lwc/jsconfig.json
jsconfig.json
.vscode/

# LWC Jest coverage reports
coverage/

# Apex coverage reports
tests/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependency directories
node_modules/

# Eslint cache
.eslintcache

# MacOS system files
.DS_Store

# Windows system files
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# VS code project settings
.vscode/*
!.vscode/extensions.json

# Local environment variables
.env

# non repo temp code
sfGpsTemp/*

# non repo *Full
sfGpsDsAuNswFull/*
sfGpsDsAuNswSFull/*
sfGpsDsAuQldFull/*
sfGpsDsAuVic1Full/*
sfGpsDsAuVic2Full/*
sfGpsDsCaOnFull/*
sfGpsDsFrGovFull/*
sfGpsDsUkGovFull/*

# auto-generated LWCs for Omniscript/Omnistudio
**/lwc/*Os/**

# auto-generated CSS
**/lwc/**/*.gen.css
**/lwc/**/*.gen.scss
**/aura/**/*.gen.css
**/aura/**/*.gen.scss
**/staticresources/**/*.gen.css
**/staticresources/**/*.gen.scss

# Source maps (generated during build, not needed in production)
**/lwc/**/*.css.map
**/lwc/**/*.gen.css.map
**/staticresources/**/*.map

# Generated scoped CSS (from SCSS sources via cssgen)
# Components with .scss files should generate .scoped.css at build time
**/lwc/**/*.scoped.css

# Local-only documentation (not tracked in repo)
sfGpsDsCaOn/docs/EASR_GUIDE.md
sfGpsDsCaOn/docs/STAKEHOLDER_BRIEFING.md

# Local-only components (not tracked in repo)
sfGpsDsCaOn/main/default/lwc/sfGpsDsCaOnFeatureCard/
sfGpsDsCaOn/main/default/lwc/sfGpsDsCaOnActionCard/
sfGpsDsCaOn/main/default/lwc/sfGpsDsCaOnLinkCard/
sfGpsDsCaOn/__tests__/sfGpsDsCaOnActionCard.test.js
