{
  "sfGpsDsCaOnCard/ontario-card*": [
    { "target": "sfGpsDsCaOnCard/sfGpsDsCaOnCard.scoped" }
  ],
  "sfGpsDsCaOnCardCollectionLwr/ontario-card-collection*": [
    { "target": "sfGpsDsCaOnCardCollectionLwr/sfGpsDsCaOnCardCollectionLwr.scoped" },
    {
      "from": "::slotted\\(ontario-card\\)",
      "to": ".ontario-card"
    },
    {
      "from": "card-collecton",
      "to": "card-collection"
    }
  ]
}
